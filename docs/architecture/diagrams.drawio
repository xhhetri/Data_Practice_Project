  <diagram name="Page-1" id="iUxb63Q3auqKOndwfPwp">
    <mxGraphModel dx="2289" dy="1249" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    DRIVER    ||--o{ TRIP           : \&quot;drives\&quot;\n    BUS       ||--o{ TRIP           : \&quot;assigned_to\&quot;\n    ROUTE     ||--o{ TRIP           : \&quot;followed_by\&quot;\n    BUS       ||--o{ MAINTENANCE    : \&quot;goes_through\&quot;\n    TRIP      ||--o{ GPS_LOCATION   : \&quot;records\&quot;\n    TRIP      ||--o{ TICKET         : \&quot;generates\&quot;\n    FARE_TYPE ||--o{ TICKET         : \&quot;applies_to\&quot;\n    ROUTE     ||--o{ ROUTE_STOP     : \&quot;has_stop\&quot;\n    BUS_STOP  ||--o{ ROUTE_STOP     : \&quot;served_by\&quot;\n    PAYMENT   ||--o{ PAYMENT_TICKET : \&quot;pays_for\&quot;\n    TICKET    ||--o{ PAYMENT_TICKET : \&quot;paid_by\&quot;\n\n    DRIVER {\n        int      driver_id         PK \&quot;IDENTITY\&quot;\n        varchar  first_name           \&quot;NOT NULL, from composite driver_name\&quot;\n        varchar  last_name            \&quot;NOT NULL, from composite driver_name\&quot;\n        varchar  license_number    UK \&quot;NOT NULL\&quot;\n        date     license_expiry       \&quot;NOT NULL\&quot;\n        varchar  phone\n        varchar  employment_status    \&quot;NOT NULL, CHECK IN (ACTIVE,SUSPENDED,TERMINATED)\&quot;\n    }\n\n    BUS {\n        int      bus_id              PK \&quot;IDENTITY\&quot;\n        varchar  registration_number UK \&quot;NOT NULL\&quot;\n        varchar  bus_model\n        int      capacity               \&quot;CHECK capacity &gt; 0\&quot;\n        int      manufacture_year\n        varchar  bus_status             \&quot;NOT NULL, CHECK IN (ACTIVE,MAINTENANCE,RETIRED)\&quot;\n    }\n\n    ROUTE {\n        int      route_id     PK \&quot;IDENTITY\&quot;\n        varchar  route_name      \&quot;NOT NULL\&quot;\n        varchar  origin          \&quot;NOT NULL\&quot;\n        varchar  destination     \&quot;NOT NULL\&quot;\n        decimal  distance_km     \&quot;CHECK distance_km &gt; 0\&quot;\n    }\n\n    BUS_STOP {\n        int      stop_id   PK \&quot;IDENTITY\&quot;\n        varchar  stop_name    \&quot;NOT NULL\&quot;\n        decimal  latitude     \&quot;CHECK BETWEEN -90 AND 90\&quot;\n        decimal  longitude    \&quot;CHECK BETWEEN -180 AND 180\&quot;\n    }\n\n    ROUTE_STOP {\n        int      route_id      PK,FK \&quot;-&gt; ROUTE, ON DELETE CASCADE\&quot;\n        int      stop_id       PK,FK \&quot;-&gt; BUS_STOP, ON DELETE CASCADE\&quot;\n        int      stop_sequence       \&quot;NOT NULL, UNIQUE(route_id, stop_sequence)\&quot;\n    }\n\n    TRIP {\n        int      trip_id             PK \&quot;IDENTITY\&quot;\n        int      driver_id           FK \&quot;NOT NULL -&gt; DRIVER\&quot;\n        int      bus_id              FK \&quot;NOT NULL -&gt; BUS\&quot;\n        int      route_id            FK \&quot;NOT NULL -&gt; ROUTE\&quot;\n        datetime scheduled_departure    \&quot;NOT NULL\&quot;\n        datetime actual_departure\n        datetime scheduled_arrival      \&quot;NOT NULL, CHECK &gt; scheduled_departure\&quot;\n        datetime actual_arrival\n        varchar  trip_status            \&quot;NOT NULL, CHECK IN (SCHEDULED,IN_PROGRESS,COMPLETED,CANCELLED)\&quot;\n    }\n\n    MAINTENANCE {\n        int      maintenance_id     PK \&quot;IDENTITY\&quot;\n        int      bus_id             FK \&quot;NOT NULL -&gt; BUS, ON DELETE CASCADE\&quot;\n        date     maintenance_date      \&quot;NOT NULL\&quot;\n        varchar  maintenance_type      \&quot;NOT NULL\&quot;\n        text     description\n        decimal  maintenance_cost      \&quot;CHECK maintenance_cost &gt;= 0\&quot;\n        varchar  maintenance_status    \&quot;NOT NULL, CHECK IN (OPEN,IN_PROGRESS,CLOSED)\&quot;\n    }\n\n    GPS_LOCATION {\n        int      gps_id        PK \&quot;IDENTITY\&quot;\n        int      trip_id       FK \&quot;NOT NULL -&gt; TRIP, ON DELETE CASCADE\&quot;\n        decimal  latitude         \&quot;NOT NULL, CHECK BETWEEN -90 AND 90\&quot;\n        decimal  longitude        \&quot;NOT NULL, CHECK BETWEEN -180 AND 180\&quot;\n        datetime recorded_time    \&quot;NOT NULL, INDEX (trip_id, recorded_time)\&quot;\n    }\n\n    FARE_TYPE {\n        int      fare_type_id PK \&quot;IDENTITY\&quot;\n        varchar  fare_name    UK \&quot;NOT NULL\&quot;\n        decimal  fare_amount     \&quot;NOT NULL, CHECK fare_amount &gt;= 0\&quot;\n        text     description\n    }\n\n    TICKET {\n        int      ticket_id        PK \&quot;IDENTITY\&quot;\n        int      trip_id          FK \&quot;NOT NULL -&gt; TRIP, ON DELETE CASCADE\&quot;\n        int      fare_type_id     FK \&quot;NOT NULL -&gt; FARE_TYPE, ON DELETE RESTRICT\&quot;\n        decimal  ticket_price        \&quot;NOT NULL, CHECK ticket_price &gt;= 0\&quot;\n        datetime purchase_datetime   \&quot;NOT NULL, DEFAULT now()\&quot;\n        varchar  ticket_status       \&quot;NOT NULL, CHECK IN (VALID,USED,CANCELLED,REFUNDED)\&quot;\n    }\n\n    PAYMENT {\n        int      payment_id       PK \&quot;IDENTITY\&quot;\n        datetime payment_datetime    \&quot;NOT NULL, DEFAULT now()\&quot;\n        varchar  payment_method      \&quot;NOT NULL, CHECK IN (CASH,CARD,MOBILE,VOUCHER)\&quot;\n        decimal  total_amount        \&quot;NOT NULL, CHECK total_amount &gt;= 0\&quot;\n        varchar  payment_status      \&quot;NOT NULL, CHECK IN (PENDING,COMPLETED,FAILED,REFUNDED)\&quot;\n    }\n\n    PAYMENT_TICKET {\n        int      payment_id     PK,FK \&quot;-&gt; PAYMENT, ON DELETE CASCADE\&quot;\n        int      ticket_id      PK,FK \&quot;-&gt; TICKET, ON DELETE RESTRICT\&quot;\n        decimal  amount_applied       \&quot;CHECK amount_applied &gt;= 0\&quot;\n    }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CfUEI-yiUS_Ev3rJx753-345">
